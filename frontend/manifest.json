{
  "manifest_version": 3,
  "name": "Correctly V5.11",
  "version": "5.11.0",
  "version_name": "5.11.0",
  "description": "Personal AI writing assistant (V5.11: one modal to correct, rewrite or translate text with your Gemini or OpenAI keys; usage limits; local statistics and estimated cost; local text shortcuts).",
  "minimum_chrome_version": "120",
  "permissions": ["activeTab", "contextMenus", "scripting", "storage"],
  "optional_host_permissions": ["<all_urls>"],
  "host_permissions": [
    "https://generativelanguage.googleapis.com/*",
    "https://api.openai.com/*"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open Correctly (Ctrl+M)"
  },
  "commands": {
    "open-correctly": {
      "suggested_key": { "default": "Ctrl+M", "mac": "MacCtrl+M" },
      "description": "Open Correctly (correction, reformulation, translation)"
    },
    "correct-selection": {
      "suggested_key": { "default": "Alt+Shift+C", "mac": "Alt+Shift+C" },
      "description": "Correct the selected text"
    },
    "rewrite-selection": {
      "description": "Rewrite the selected text (choose styles)"
    },
    "translate-selection": {
      "description": "Translate the selected text (choose languages)"
    }
  },
  "options_page": "src/options/options.html",
  "content_security_policy": {
    "extension_pages": "default-src 'self'; script-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; connect-src 'self' https://generativelanguage.googleapis.com https://api.openai.com"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
