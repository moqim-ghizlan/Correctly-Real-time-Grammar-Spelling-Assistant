{
  "name": "correctly",
  "version": "5.7.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build && node scripts/dev.mjs",
    "typecheck": "tsc --noEmit -p frontend/tsconfig.json",
    "build": "npm run typecheck && vite build --config frontend/vite.config.ts && vite build --config frontend/vite.content.config.ts && vite build --config frontend/vite.content.config.ts --mode smart && node scripts/verify-build.mjs",
    "verify": "node scripts/verify-build.mjs",
    "package": "npm run build && node scripts/package.mjs",
    "test": "vitest run --config frontend/vitest.config.ts",
    "test:watch": "vitest --config frontend/vitest.config.ts",
    "test:browser": "npm run build && node scripts/verify-browser.mjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/chrome": "^0.1.24",
    "@types/node": "^22.0.0",
    "eslint": "^10.12.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0",
    "vite": "^6.4.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  }
}
